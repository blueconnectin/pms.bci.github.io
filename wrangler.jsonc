{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payment-blueconnect",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbzSlPMUFTn6WUINNiRJjF6sSQ_WvEeXZIatAJ6wCgyCFlvOGVS9f2_DTMsvytClhwM/exec"
  }
}
